#!/bin/sh
# main only changes through merged pull requests (see AGENTS.md).
branch=$(git symbolic-ref --short -q HEAD)
if [ "$branch" = "main" ]; then
  echo "pre-commit: direct commits to main are not allowed; commit on a branch and open a pull request." >&2
  exit 1
fi

if ! command -v gitleaks > /dev/null 2>&1; then
  echo "pre-commit: install Gitleaks (brew install gitleaks), then retry. See SECURITY.md." >&2
  exit 1
fi

exec gitleaks git --staged --redact --verbose --no-banner --ignore-gitleaks-allow --config .gitleaks.toml
