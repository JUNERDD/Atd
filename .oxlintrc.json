{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y"],
  "jsPlugins": ["@shadcn/lint"],
  "categories": { "correctness": "error" },
  "rules": {
    "react/only-export-components": ["error", { "allowConstantExport": true }],
    "shadcn/no-raw-colors": "error",
    "shadcn/no-arbitrary-values": ["error", { "allow": ["layout"] }],
    "shadcn/no-inline-styles": "error",
    "shadcn/require-static-classes": "error",
    "shadcn/no-unknown-classes": "warn"
  },
  "env": { "browser": true, "node": true },
  "overrides": [
    {
      "files": ["**/*.ts", "**/*.tsx"],
      "rules": {
        "max-lines": ["error", { "max": 350, "skipBlankLines": false, "skipComments": false }]
      }
    },
    {
      "files": ["packages/plugin-kit/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@ai/*", "@earendil-works/*", "electron", "react", "react-dom"],
                "message": "plugin-kit is host-agnostic and will be published on its own; take host behavior through a port."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/ui/src/components/**"],
      "rules": {
        "shadcn/no-arbitrary-values": "off",
        "shadcn/require-static-classes": "off"
      }
    }
  ],
  "ignorePatterns": ["**/dist/**", "**/dist-electron/**", "**/release/**", "**/.artifacts/**"]
}
