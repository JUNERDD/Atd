{
  "name": "@atd/agent-service",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "agent-service": "dist/cli.js"
  },
  "files": [
    "dist",
    "product-skills",
    "vendor",
    "view-kit"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node scripts/dev.mjs serve --development --dataDir \"$HOME/Library/Application Support/AgentService Dev\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p scripts/tsconfig.json",
    "lint": "oxlint src test scripts view-kit",
    "seed:dev": "node --import jiti/register scripts/seed-dev-data.ts",
    "test": "tsc -p tsconfig.json && tsc -p test/tsconfig.json && node --test 'test/**/*.test.ts'"
  },
  "dependencies": {
    "@atd/agent-contracts": "workspace:*",
    "@atd/app-kit": "workspace:*",
    "@atd/file-index": "workspace:*",
    "@atd/plugin-kit": "workspace:*",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-mcp": "1.4.0",
    "@fastify/websocket": "11.3.4",
    "@joplin/turndown-plugin-gfm": "1.0.68",
    "@juicesharp/rpiv-todo": "2.15.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@napi-rs/keyring": "2.1.2",
    "@xmldom/xmldom": "0.8.15",
    "agent-base": "catalog:",
    "chardet": "2.2.0",
    "croner": "catalog:",
    "eventsource-parser": "4.1.3",
    "fastify": "5.12.7",
    "fflate": "0.8.3",
    "http-proxy-agent": "catalog:",
    "https-proxy-agent": "catalog:",
    "jiti": "2.7.0",
    "mammoth": "1.13.0",
    "openid-client": "catalog:",
    "pi-subagents": "0.76.1",
    "pi-web-access": "0.44.0",
    "playwright-core": "1.64.1",
    "tar": "7.5.22",
    "turndown": "7.2.4",
    "typebox": "catalog:",
    "undici": "catalog:",
    "unpdf": "1.9.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@atd/typescript-config": "workspace:*",
    "@types/turndown": "5.0.6",
    "@types/ws": "8.18.2"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  }
}
