{
  "name": "@ai/agent-service",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "agent-service": "dist/cli.js"
  },
  "files": [
    "dist",
    "product-skills"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src test",
    "test": "tsc -p tsconfig.json && tsc -p test/tsconfig.json && node --test 'test/**/*.test.ts'"
  },
  "dependencies": {
    "@ai/agent-contracts": "workspace:*",
    "@ai/plugin-kit": "workspace:*",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@fastify/websocket": "11.3.1",
    "@juicesharp/rpiv-todo": "2.11.0",
    "@napi-rs/keyring": "2.1.0",
    "fastify": "5.12.5",
    "fdir": "6.5.0",
    "jiti": "2.7.0",
    "pi-hermes-memory": "0.9.9",
    "pi-mcp-adapter": "3.1.0",
    "pi-subagents": "0.73.1",
    "pi-web-access": "0.33.0",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@ai/typescript-config": "workspace:*",
    "@types/ws": "8.18.1"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  }
}
