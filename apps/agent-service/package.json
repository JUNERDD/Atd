{
  "name": "@atd/agent-service",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "agent-service": "dist/cli.js"
  },
  "files": [
    "dist",
    "product-skills"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch-path=src --watch-preserve-output --import jiti/register src/cli.ts serve --dataDir \"$HOME/Library/Application Support/AgentService Dev\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p scripts/tsconfig.json",
    "lint": "oxlint src test scripts",
    "seed:dev": "node --import jiti/register scripts/seed-dev-data.ts",
    "test": "tsc -p tsconfig.json && tsc -p test/tsconfig.json && node --test 'test/**/*.test.ts'"
  },
  "dependencies": {
    "@atd/agent-contracts": "workspace:*",
    "@atd/app-kit": "workspace:*",
    "@atd/file-index": "workspace:*",
    "@atd/plugin-kit": "workspace:*",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0",
    "@fastify/websocket": "11.3.3",
    "@juicesharp/rpiv-todo": "2.12.0",
    "@napi-rs/keyring": "2.1.0",
    "croner": "catalog:",
    "eventsource-parser": "4.1.1",
    "fastify": "5.12.5",
    "jiti": "2.7.0",
    "pi-subagents": "0.76.1",
    "pi-web-access": "0.37.0",
    "typebox": "catalog:"
  },
  "devDependencies": {
    "@atd/typescript-config": "workspace:*",
    "@types/ws": "8.18.2"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  }
}
