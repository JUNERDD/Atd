{
  "name": "@ai/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "A quiet desktop task panel, built from Figma.",
  "author": "JUNERDD",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode web",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint src electron tests *.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:electron": "playwright test",
    "package": "electron-builder --dir --publish never"
  },
  "dependencies": {
    "@ai/ui": "workspace:*",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@fontsource-variable/inter": "5.3.0",
    "@uiw/react-codemirror": "4.25.11",
    "jiti": "2.7.0",
    "lucide-react": "1.42.0",
    "mustache": "4.2.0",
    "pi-hermes-memory": "0.9.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hotkeys-hook": "5.3.3",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "selection-hook": "2.1.1",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@ai/typescript-config": "workspace:*",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/mustache": "4.2.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "vite": "8.2.2",
    "vite-plugin-electron": "1.1.2",
    "vitest": "5.0.0"
  }
}
