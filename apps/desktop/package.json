{
  "name": "@ai/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "A quiet desktop task panel, built from Figma.",
  "author": "JUNERDD",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode web",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint src electron tests plugins *.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:electron": "playwright test",
    "package": "node ./scripts/prepare-service-pack.mjs && electron-builder --dir --publish never"
  },
  "dependencies": {
    "@ai/agent-client": "workspace:*",
    "@ai/agent-contracts": "workspace:*",
    "@ai/ui": "workspace:*",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@fontsource-variable/inter": "5.3.0",
    "@streamdown/code": "1.1.1",
    "@streamdown/mermaid": "1.0.2",
    "@uiw/react-codemirror": "4.25.11",
    "fdir": "6.5.0",
    "i18next": "26.4.2",
    "lucide-react": "1.42.0",
    "motion": "13.2.0",
    "mustache": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hot-toast": "2.6.0",
    "react-hotkeys-hook": "5.3.3",
    "react-i18next": "17.0.14",
    "rehype-harden": "1.1.8",
