{
  "extends": "@ai/typescript-config/react.json",
  "compilerOptions": {
    // The renderer runs only in WKWebView on macOS 26, which ships ES2023 (`findLast`).
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    // The native bridge contract imports its parts by `.ts` file name, which Node's type
    // stripping needs when the schema export script loads it.
    "allowImportingTsExtensions": true,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "tests", "*.ts", "plugins"]
}
