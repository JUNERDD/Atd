{
  "extends": "@atd/typescript-config/react.json",
  "compilerOptions": {
    // The renderer runs only in WKWebView on macOS 26, which ships ES2025 (Set methods,
    // iterator helpers, `Promise.try`).
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    // The native bridge contract imports its parts by `.ts` file name, which Node's type
    // stripping needs when the schema export script loads it.
    "allowImportingTsExtensions": true
  },
  "include": ["src", "tests", "*.ts", "plugins"]
}
