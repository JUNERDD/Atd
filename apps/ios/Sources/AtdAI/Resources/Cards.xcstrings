    "card.now %@ %@ %@" : {
      "comment" : "Part of the prompt sent to the model (not shown in the interface): the current date and time (2026-11-21 14:05), the weekday, and the time zone identifier",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is now %1$@ (%2$@), time zone %3$@. Work out relative dates such as “tomorrow” or “next Friday” from this."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现在是 %1$@（%2$@），时区 %3$@。“明天”“下周五”这类相对日期都从这里推算。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
