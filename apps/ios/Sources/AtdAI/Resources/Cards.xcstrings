            "state" : "translated",
            "value" : "Atd can’t read reminders."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "读取不到提醒事项。"
          }
        }
      }
    },
    "card.agenda.none" : {
      "comment" : "Part of the prompt sent to the model (not shown in the interface): an agenda list with nothing in it",
      "extractionState" : "manual",
