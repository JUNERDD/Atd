            "state" : "translated",
            "value" : "All day"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全天"
          }
        }
      }
    },
    "card.agenda.day %@ %@" : {
      "comment" : "Part of the prompt sent to the model (not shown in the interface): first line of the agenda sent for a briefing: the date and the weekday of the day it is for",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The day: %1$@ (%2$@)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日期：%1$@（%2$@）。"
          }
        }
      }
    },
