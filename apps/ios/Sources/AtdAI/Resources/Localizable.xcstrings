    "prompt.ask" : {
      "comment" : "Part of the prompt sent to the model (not shown in the interface): system prompt for Ask Atd",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are Atd, answering questions on a phone. Answer briefly and directly, in the language of the question."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你是 Atd，在手机上回答问题。回答简短直接，用提问用的语言。"
          }
        }
      }
    },
    "prompt.base" : {
      "comment" : "Part of the prompt sent to the model (not shown in the interface): the rule every command follows",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Output only the resulting text, without quotation marks or explanations. Unless the instructions say otherwise, keep the language of the original."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只输出结果文本，不加引号和解释；除非指令另有要求，保持原文的语言。"
          }
        }
      }
    },
    "prompt.continue" : {
      "comment" : "Part of the prompt sent to the model (not shown in the interface): instructions for continuing the text before the cursor",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue the text from where it ends. Output only the new part, without repeating what is already written."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从这段文字的结尾接着往下写，只输出新写的部分，不重复已有的内容。"
          }
        }
      }
    },
    "prompt.draftRule" : {
      "comment" : "Part of the prompt sent to the model (not shown in the interface): how to use the person's draft when replying to a copied message",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The reply should say what I want to say; where it conflicts with their message, follow what I want to say."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回复要表达“我想说的”；它和对方的消息有冲突时，以“我想说的”为准。"
          }
        }
      }
    },
    "prompt.instructions %@" : {
      "comment" : "Part of the prompt sent to the model (not shown in the interface): introduces the command's instructions",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instructions: %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要求：%@"
          }
        }
      }
    },
    "prompt.myDraft" : {
      "comment" : "Part of the prompt sent to the model (not shown in the interface): label before the person's draft of what to say",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What I want to say:"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我想说的："
          }
        }
      }
    },
    "prompt.option %@ %@" : {
      "comment" : "Part of the prompt sent to the model (not shown in the interface): one command option, label then chosen value",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@：%2$@"
          }
        }
      }
    },
    "prompt.theirMessage" : {
      "comment" : "Part of the prompt sent to the model (not shown in the interface): label before the copied message being replied to",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Their message:"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对方的消息："
          }
        }
      }
    }
  },
  "version" : "1.0"
}
