{
  "sourceLanguage" : "en",
  "strings" : {
    "automations.added %@" : {
      "comment" : "VoiceOver announcement after adding an automation; the argument is its trigger",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Added “%@”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已添加「%@」"
          }
        }
      }
    },
    "automations.footer" : {
      "comment" : "Under the list of automations",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You create each automation once in Shortcuts. These switches only decide whether Atd acts when one is triggered."
          }
