    "failure.calendar" : {
      "comment" : "Atd may not read or add to Calendar",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atd can't access Calendar. You can allow it in Settings › Apps › Atd."
