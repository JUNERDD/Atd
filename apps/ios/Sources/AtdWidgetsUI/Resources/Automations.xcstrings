{
  "sourceLanguage" : "en",
  "strings" : {
    "activity.continue" : {
      "comment" : "Live Activity: the run stopped; a tap opens Atd to continue it",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap to continue"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点一下继续"
          }
        }
      }
    },
    "activity.continue.from %@" : {
      "comment" : "Live Activity: the run stopped at this step; a tap opens Atd to continue from it",
