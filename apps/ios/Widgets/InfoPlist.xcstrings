{
  "sourceLanguage" : "en",
  "strings" : {
    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Calendar permission prompt (full access), shown the first time Atd reads your events",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you ask about your schedule or check Today's Briefing, Atd reads that day's events to answer you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你问到日程或看今日简报时，Atd 读取对应日期的安排来回答你。"
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription" : {
      "comment" : "Reminders permission prompt, shown the first time Atd adds a to-do or reads today's reminders",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atd adds the to-dos you confirm to Reminders, and reads today's reminders for Today's Briefing."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atd 会把你确认过的待办加到提醒事项，看今日简报时读取今天的提醒。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
