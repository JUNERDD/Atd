          }
        }
      }
    },
    "automation.notice.attention.title" : {
      "comment" : "Title of the notification of an automation run that declined actions or questions because nobody was there; %@ is the automation's name",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” needs your attention"
