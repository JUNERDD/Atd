    "capture.hint.accessibility" : {
      "comment" : "Capture overlay hint shown when Accessibility is not allowed; clicking it asks for the permission",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Accessibility to detect interface elements"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许辅助功能以识别界面元素"
          }
        }
      }
    },
    "capture.hint.idle" : {
      "comment" : "Hint at the bottom of the capture overlay before an area is selected",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click a highlighted area or drag to select · Scroll for a larger area · ⌘A for the whole screen · Esc to cancel"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击高亮区域或拖动选择 · 滚动切换更大区域 · ⌘A 选择整个屏幕 · Esc 取消"
          }
        }
      }
    },
    "capture.hint.recall" : {
      "comment" : "Capture overlay hint shown while a previous area exists on this display; R commits it",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "R to reuse the last area"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "R 复用上次区域"
          }
        }
      }
    },
    "capture.hint.selected" : {
      "comment" : "Hint at the bottom of the capture overlay once an area is selected",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag the edges to resize · Return to confirm · Esc to go back"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动边缘调整大小 · 回车确认 · Esc 返回"
          }
        }
      }
    },
    "capture.hint.windowsOnly" : {
      "comment" : "Capture overlay hint shown while element detection is limited to windows; W toggles it",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows only · W to detect elements again"
