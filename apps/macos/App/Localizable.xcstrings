        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”未能完成"
          }
        }
      }
    },
    "automation.notice.paused.body" : {
      "comment" : "Body of the notification sent when Atd turned an automation off after repeated failures; names the Automations settings section",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It failed several times in a row. You can turn it back on in Settings › Automations."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它连续多次运行失败。你可以在“设置 › 自动化”中重新开启。"
          }
        }
      }
    },
    "automation.notice.paused.title" : {
