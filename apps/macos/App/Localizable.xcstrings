{
  "sourceLanguage" : "en",
  "strings" : {
    "app.name" : {
      "comment" : "App name in menus and alerts",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atd"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atd"
          }
        }
      }
    },
    "app.pick.title" : {
      "comment" : "Title of the open panel that picks apps the selection toolbar stays out of",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose apps where the selection toolbar stays hidden"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择不显示选择文字工具栏的 App"
          }
        }
      }
    },
    "artifact.open.message" : {
      "comment" : "Message of the confirmation before opening a downloaded file that can run code",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This file type can run code on your Mac. Open it only if you trust where it came from."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这种文件可以在你的 Mac 上运行代码。只有在你信任它的来源时才打开。"
          }
        }
      }
    },
    "artifact.open.openAnyway" : {
      "comment" : "Destructive button of the open confirmation: opens the file",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Anyway"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仍要打开"
          }
        }
      }
    },
    "artifact.open.showInFinder" : {
      "comment" : "Default button of the open confirmation: reveals the file instead of opening it",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show in Finder"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在访达中显示"
          }
        }
      }
    },
    "artifact.open.title" : {
      "comment" : "Title of the confirmation before opening a downloaded file that can run code; %@ is the file name",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open “%@”?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开“%@”吗？"
          }
        }
      }
    },
    "automation.notice.attention.body" : {
      "comment" : "Body of a needs-attention automation notification when the number of declined actions and questions is unknown",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some actions or questions were declined because no one was there."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于无人在场，部分操作或提问已被拒绝。"
          }
        }
      }
    },
    "automation.notice.attention.declined.one" : {
      "comment" : "Body of a needs-attention automation notification for one declined action or question",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 action or question was declined because no one was there."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于无人在场，已拒绝 1 项操作或提问。"
          }
        }
      }
    },
    "automation.notice.attention.declined.other" : {
      "comment" : "Body of a needs-attention automation notification; %lld is the number of declined actions and questions",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld actions or questions were declined because no one was there."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
