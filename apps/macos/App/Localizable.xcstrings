    "capture.hint.accessibility" : {
      "comment" : "Capture overlay hint shown when Accessibility is not allowed; clicking it asks for the permission",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Accessibility to detect interface elements"
