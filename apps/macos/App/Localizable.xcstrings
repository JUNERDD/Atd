    "taskActivity.access.application" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atd will operate this app in the background. When the background can’t do a step, Atd briefly brings the app forward and sends that step’s clicks and keys straight to it, without moving your pointer, then switches back to the app and window you were using."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atd 将在后台操作此应用。后台无法完成某一步时，Atd 会短暂把应用调到前面，把这一步的点击和按键直接发给它，不会移动你的指针，然后切回你原来的应用和窗口。"
          }
        }
      }
    },
    "taskActivity.access.background" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atd will operate this target in the background, without bringing it forward or using your pointer and keyboard."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atd 将在后台操作此目标，不会把它切到前台，也不会占用你的指针和键盘。"
          }
        }
      }
    },
