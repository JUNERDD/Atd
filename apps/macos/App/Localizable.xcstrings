        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”需要你处理"
          }
        }
      }
    },
    "automation.notice.delivered.body" : {
      "comment" : "Body of an automation's notification when the run's result came without a summary",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finished — open to see the result."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已完成，打开即可查看结果。"
          }
        }
      }
    },
    "automation.notice.failed.body" : {
      "comment" : "Body of a failed automation notification when the run reported no error",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something went wrong before it could finish."
