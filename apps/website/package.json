{
  "name": "@atd/website",
  "version": "0.0.0",
  "private": true,
  "description": "The Atd website: a prerendered static site with a WebGL dot-matrix hero.",
  "author": "JUNERDD",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.ts",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint src scripts *.ts"
  },
  "devDependencies": {
    "@atd/typescript-config": "workspace:*",
    "@fontsource-variable/doto": "5.3.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "6.1.1",
    "embla-carousel-autoplay": "catalog:",
    "embla-carousel-react": "catalog:",
    "lucide-react": "catalog:",
    "radix-ui": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "8.3.1"
  }
}
