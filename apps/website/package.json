{
  "name": "@atd/website",
  "version": "0.0.0",
  "private": true,
  "description": "The Atd website: a prerendered static site with a WebGL dot-matrix hero.",
  "author": "JUNERDD",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.ts",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint src scripts api *.ts",
    "assets:upload": "node scripts/upload-assets.mjs",
    "assets:publish": "node scripts/upload-assets.mjs --bucket atd-assets --if-configured",
    "assets:check": "node scripts/check-asset-delivery.mjs"
  },
  "devDependencies": {
    "@atd/typescript-config": "workspace:*",
    "@fontsource-variable/doto": "5.3.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "6.1.2",
    "aws4fetch": "catalog:",
    "image-size": "2.0.4",
    "lucide-react": "catalog:",
    "marked": "catalog:",
    "marked-cjk-friendly": "catalog:",
    "radix-ui": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typebox": "catalog:",
    "vite": "8.3.5",
    "wrangler": "4.152.0",
    "yaml": "2.9.1"
  }
}
