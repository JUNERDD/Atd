{
  "rules": [
    {
      "allowed": {
        "origins": ["*"],
        "methods": ["GET", "HEAD"],
        "headers": ["Range"]
      },
      "exposeHeaders": [
        "Content-Length",
        "Content-Range",
        "Accept-Ranges",
        "ETag",
        "Cache-Control",
        "CF-Cache-Status"
      ],
      "maxAgeSeconds": 3600
    }
  ]
}
