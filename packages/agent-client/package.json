{
  "name": "@atd/agent-client",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "lint": "oxlint src",
    "test": "tsc -p tsconfig.json && node --test 'test/**/*.test.ts'"
  },
  "dependencies": {
    "@atd/agent-contracts": "workspace:*",
    "typebox": "catalog:"
  },
  "devDependencies": {
    "@atd/typescript-config": "workspace:*"
  }
}
