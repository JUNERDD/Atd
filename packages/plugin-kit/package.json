{
  "name": "@ai/plugin-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Install, normalize and resolve agent plugin bundles (Agent Plugins 1.0, Claude Code plugins, pi packages and Agent Skills) for any agent harness.",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./model": {
      "types": "./src/model.ts",
      "source": "./src/model.ts",
      "import": "./dist/model.js",
      "default": "./dist/model.js"
    },
    "./node": {
      "types": "./src/node.ts",
      "source": "./src/node.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./model": {
        "types": "./dist/model.d.ts",
        "import": "./dist/model.js"
      },
      "./node": {
        "types": "./dist/node.d.ts",
        "import": "./dist/node.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.pure.json --noEmit",
    "lint": "oxlint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "isomorphic-git": "1.42.5",
    "tar": "7.5.22",
    "typebox": "catalog:",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@ai/typescript-config": "workspace:*",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
