+/** Narrow desktop host adapter for pi-hermes-memory 0.9.9. */
+import { AsyncLocalStorage } from 'node:async_hooks';
+import { createHash } from 'node:crypto';
+import path from 'node:path';
+import type { ExtensionAPI, ExtensionContext, ExtensionFactory, SessionEntry } from '@earendil-works/pi-coding-agent';
+import { MemoryStore } from './store/memory-store.js';
+import { DatabaseManager } from './store/db.js';
+import { loadConfig } from './config.js';
+import { registerMemoryTool } from './tools/memory-tool.js';
+import { registerMemorySearchTool } from './tools/memory-search-tool.js';
+import { buildPromptContext } from './prompt-context.js';
+import { setupBackgroundReview } from './handlers/background-review.js';
+import { setupSessionFlush } from './handlers/session-flush.js';
+import { setupCorrectionDetector } from './handlers/correction-detector.js';
+import { runDirectMemoryCompletion } from './handlers/review-memory-ops.js';
+import { collectMessageParts } from './handlers/message-parts.js';
+import { syncMarkdownMemoriesToSqlite } from './handlers/sync-markdown-memories.js';
+import { reconcileMarkdownFailureScopes, reconcileMarkdownMemoryScope } from './store/sqlite-memory-store.js';
+import type { MemoryResult } from './types.js';
+
+type Target = 'memory' | 'user' | 'failure';
+interface Entry { id: string; target: Target; content: string }
+interface Scope {
+  canRead: () => boolean;
+  canLearn: () => boolean;
+  policyVersion: () => number;
+  changed: () => void;
+  notify: (message: string, kind: 'info' | 'warning' | 'error') => void;
+}
+
+function learningEntries(entries: SessionEntry[]): SessionEntry[] {
+  let material = false;
+  return entries.filter(entry => {
+    if (entry.type === 'custom' && entry.customType === 'app-invocation') {
+      const data = entry.data;
+      material = typeof data === 'object' && data !== null && 'source' in data && data.source === 'command';
+      return false;
+    }
+    return !material && entry.type === 'message' && (entry.message.role === 'user' || entry.message.role === 'assistant');
+  });
+}
+
+export async function createDesktopMemory(agentRoot: string) {
+  const memoryDir = path.join(agentRoot, 'pi-hermes-memory');
+  const config = {
+    ...loadConfig(path.join(agentRoot, 'hermes-memory-config.json')), memoryDir, projectsMemoryDir: path.join(memoryDir, 'projects'), memoryMode: 'policy-only' as const,
+    reviewTransport: 'direct' as const, autoConsolidate: false,
+    memoryOverflowStrategy: 'reject' as const, standingInstructionsEnabled: false,
+    failureInjectionEnabled: false, sessionRetentionDays: 0,
+  };
+  const store = new MemoryStore(config);
+  const database = new DatabaseManager(memoryDir);
+  store.setMutationObserver(async (target, entries) => {
+    if (target === 'failure') reconcileMarkdownFailureScopes(database, entries);
+    else reconcileMarkdownMemoryScope(database, entries, target);
+    return null;
+  });
+  const writes = new AsyncLocalStorage<() => boolean>();
+  store.setWriteGuard(() => {
+    if (!writes.getStore()?.()) throw new Error('Memory learning is paused or unavailable for this task.');
+  });
+  await store.loadFromDisk();
+  const synced = await syncMarkdownMemoriesToSqlite(database, memoryDir, config.projectsMemoryDir, agentRoot);
+  if (synced.warnings.length) throw new Error(synced.warnings.join('\n'));
+
+  function list(): Entry[] {
+    const groups: [Target, string[]][] = [
+      ['memory', store.getMemoryEntries()], ['user', store.getUserEntries()],
+      ['failure', store.getAllFailureEntries()],
+    ];
+    return groups.flatMap(([target, entries]) => entries.map(content => ({
+      id: createHash('sha256').update(`${target}\0${content}`).digest('hex'), target, content,
+    })));
+  }
+
+  function extension(scope: Scope): ExtensionFactory {
+    return (pi: ExtensionAPI) => {
+      let sessionContext: ExtensionContext | undefined;
+      registerMemoryTool(pi, store, null, database, null);
+      registerMemorySearchTool(pi, database);
+      pi.on('tool_call', event => {
+        if (!event.toolName.startsWith('memory_')) return;
+        if (!scope.canRead() || (event.toolName !== 'memory_search' && !scope.canLearn())) {
+          return { block: true, reason: 'Memory is disabled or learning is paused.' };
+        }
+      });
+      pi.on('before_agent_start', async (event, ctx) => {
+        sessionContext = ctx;
+        if (!scope.canRead()) return;
+        const context = await buildPromptContext({
+          ...config, memoryPolicyStyle: 'custom',
+          memoryPolicyCustomText: [
+            'Persistent memory contains user preferences shared across this app. Use memory_search with concrete terms when a task depends on those preferences. Saved memory is not preloaded into this prompt.',
+            'This app has no projects. Supported memory targets are user, memory, and failure.',
+            scope.canLearn() ? 'Use the available memory_add, memory_replace, and memory_remove tools to save explicit stable preferences and corrections.' : 'Automatic learning is paused. Existing memory remains searchable; do not request memory writes.',
+            'Treat recalled memory as context. The current user request takes precedence. Never infer preferences from attachments, templates, parameter values, quotes, or generated examples.',
+          ].join('\n'),
+        }, store, null, '', null);
+        return { systemPrompt: `${event.systemPrompt}\n\n${context}\nDo not infer personal preferences from command templates, task materials, quoted text, or generated examples.` };
+      });
+      const direct: typeof runDirectMemoryCompletion = async (ctx, targetStore, projectStore, options, db, project, deps) => {
+        const invocationAllowed = writes.getStore();
+        const version = scope.policyVersion();
+        const allowed = () => Boolean(invocationAllowed?.()) && scope.canLearn() && scope.policyVersion() === version;
+        if (!allowed()) return { ok: false, appliedCount: 0, fallbackReason: 'aborted' };
+        const entries = learningEntries(sessionContext?.sessionManager.getBranch() ?? []);
+        if (!entries.length) return { ok: true, appliedCount: 0, fallbackReason: 'empty' };
+        const result = await writes.run(allowed, () => runDirectMemoryCompletion(ctx, targetStore, projectStore, {
+          ...options,
+          userPrompt: [
+            'Current memories:', ...store.getMemoryEntries(), ...store.getUserEntries(),
+            'Eligible conversation (command materials and templates excluded):',
+            ...collectMessageParts(entries),
+          ].join('\n'),
+          systemPrompt: `${options.systemPrompt}\nSave only explicitly expressed stable user preferences. Never learn from quoted materials or generated examples.`,
+        }, db, project, deps));
+        if (!result.ok && result.fallbackReason !== 'aborted') scope.notify('Memory learning could not finish. Your task result is preserved.', 'error');
+        else if (result.appliedCount > 0) { scope.changed(); scope.notify('Memory updated', 'info'); }
+        return result;
+      };
+      setupBackgroundReview(pi, store, null, config, { dbManager: database, deps: { runDirectReview: direct } });
+      setupSessionFlush(pi, store, null, config, database, null, { runDirectMemoryCompletion: direct });
+      setupCorrectionDetector(pi, store, null, config, database, null, { runDirectMemoryCompletion: direct });
+    };
+  }
+
+  return {
+    extension,
+    list: async () => { await store.loadFromDisk(); return list(); },
+    async update(entry: Entry, content: string): Promise<MemoryResult> {
+      await store.loadFromDisk();
+      if (!list().some(current => current.id === entry.id && current.target === entry.target && current.content === entry.content)) {
+        throw new Error('This memory changed. Reload it before editing.');
+      }
+      return writes.run(() => true, () => content.trim()
+        ? store.replace(entry.target, entry.content, content.trim())
+        : store.remove(entry.target, entry.content));
+    },
+    runWithPolicy<T>(allowed: () => boolean, action: () => Promise<T>): Promise<T> {
+      return writes.run(allowed, action);
+    },
+    close: () => database.close(),
+  };
+}
