+// Avoid invoking macOS's Git shim for ordinary non-repository tasks: it can
+// request developer tools even though mutation evidence is optional.
+function hasGitWorkTree(cwd) {
+    if (process.env.GIT_DIR || process.env.GIT_WORK_TREE)
+        return true;
+    let current = fs.realpathSync(cwd);
+    for (;;) {
+        if (fs.existsSync(path.join(current, ".git")))
+            return true;
+        const parent = path.dirname(current);
+        if (parent === current)
+            return false;
+        current = parent;
+    }
