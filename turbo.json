{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": false,
  "futureFlags": {
    "watchUsingTaskInputs": true
  },
  "globalDependencies": [".node-version", ".oxlintrc.json", "pnpm-workspace.yaml"],
  "globalPassThroughEnv": [
    "AI_AGENT_DATA_DIR",
    "AI_AGENT_FORCE_RESTART",
    "AI_AGENT_LOG_LEVEL",
    "AI_AGENT_MCP_ADAPTER_PATH",
    "AI_AGENT_SHELL_ALLOWLIST",
    "AI_AGENT_TEMP_API_KEY",
    "AI_AGENT_TEMP_BASE_URL",
    "AI_AGENT_TEMP_MODEL",
    "AI_AGENT_TEMP_PROVIDER",
    "AI_ATD_HOME",
    "AI_CODE_SIGN_IDENTITY",
    "AI_DEVELOPMENT_TEAM",
    "AI_RENDERER_DEV_ORIGIN",
    "AI_RENDERER_PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-native/**"]
    },
    "@atd/file-index#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!index.js",
        "!index.d.ts",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/rust-toolchain.toml",
        "$TURBO_ROOT$/.cargo/**",
        "$TURBO_ROOT$/crates/**"
      ],
      "cache": false,
      "outputs": ["*.node", "index.js", "index.d.ts"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@atd/agent-service#dev": {
      "dependsOn": ["build"],
      "inputs": [
        "src/**",
        "view-kit/**",
        "product-skills/**",
        "package.json",
        "tsconfig.json",
        "scripts/dev.mjs"
      ],
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "passThroughEnv": ["NODE_COMPILE_CACHE", "NODE_DISABLE_COMPILE_CACHE"]
    },
    "@atd/agent-service#build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "package.json", "tsconfig.json"],
      "outputs": ["dist/**"]
    },
    "dev:renderer": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "@atd/agent-service#lint": {
      "dependsOn": ["transit", "build"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "format:check": {},
    "@atd/macos#build": {
      "cache": false
    },
    "codegen:check": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/desktop/src/native-bridge/native-bridge.schema.json",
        "$TURBO_ROOT$/apps/desktop/src/native-bridge/user-app-bridge.schema.json",
        "$TURBO_ROOT$/packages/agent-contracts/package.json",
        "$TURBO_ROOT$/packages/agent-contracts/src/**",
        "$TURBO_ROOT$/packages/plugin-kit/package.json",
        "$TURBO_ROOT$/packages/plugin-kit/src/**",
        "$TURBO_ROOT$/packages/ui/src/assets/brands/**"
      ],
      "outputs": []
    },
    "transit": {
      "dependsOn": ["^transit"]
    }
  }
}
