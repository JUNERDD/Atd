{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [".oxlintrc.json", "pnpm-workspace.yaml"],
  "globalPassThroughEnv": [
    "AI_TEST_USER_DATA",
    "AI_AGENT_DATA_DIR",
    "AI_AGENT_FORCE_RESTART",
    "AI_AGENT_LOG_LEVEL",
    "AI_AGENT_MCP_ADAPTER_PATH",
    "AI_AGENT_SHELL_ALLOWLIST",
    "AI_AGENT_TEMP_API_KEY",
    "AI_AGENT_TEMP_BASE_URL",
    "AI_AGENT_TEMP_MODEL",
    "AI_AGENT_TEMP_PROVIDER"
  ],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", "dist-electron/**"] },
    "dev": {
      "dependsOn": ["^build", "@ai/agent-service#build"],
      "cache": false,
      "persistent": true
    },
    "dev:web": { "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^lint"] },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "dependsOn": ["^typecheck"], "outputs": [] }
  }
}
